# Margaret's MemoryCare Music — PRODUCTION environment variables
#
# HOW TO USE THIS FILE
# --------------------
# Do NOT commit real secrets. On Vercel, add each variable below under:
#   Project → Settings → Environment Variables  (Environment: Production)
# Copy the KEY names from here and paste your real VALUES in the Vercel UI.
# After changing any variable in Vercel, redeploy for it to take effect.
#
# (If you also want to build a production bundle locally, copy this file to
#  .env.production.local — that filename is gitignored — and fill in real values.)


# ── Supabase (required) ───────────────────────────────────────────────────────
# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key      # safe to expose in browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key         # SECRET — server only, never expose

# ── Application URL (required in production) ───────────────────────────────────
# Your live domain. Used for email callback links (password reset, confirmations).
# Set to the custom domain you connect in Vercel, e.g. https://margaretsmemorycaremusic.com
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Email delivery via Resend (add once your sending domain is verified) ───────
# resend.com → API Keys.  Until this is real, confirmation/reset emails won't send.
RESEND_API_KEY=re_your_real_key
EMAIL_FROM_ADDRESS=hello@your-domain.com                # must be on a Resend-verified domain
EMAIL_REPLY_TO=hello@your-domain.com

# ── Coming Soon gate ──────────────────────────────────────────────────────────
# "true"  → whole site shows the /coming-soon placeholder.
# "false" → the full app is live. Set this when you launch.
# Unset    → production deployments are gated by default; previews are not.
COMING_SOON=true
